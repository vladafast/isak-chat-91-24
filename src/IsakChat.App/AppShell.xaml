<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:IsakChat.App.Views"
       x:Class="IsakChat.App.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="QuickChat">

    <!-- Login/Register su deo strukture Shell-a (ne samo "labave" rute) da bi apsolutna
         navigacija (npr. "//login") ispravno radila kao restart navigacione stranice. -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="register" Title="Registracija" ContentTemplate="{DataTemplate views:RegisterPage}" />

    <!-- Glavna navigacija posle logovanja - TabbedPage koncept kroz Shell TabBar -->
    <TabBar Route="main">
        <ShellContent Route="public" Title="Četovnica" ContentTemplate="{DataTemplate views:PublicChatPage}" />
        <ShellContent Route="messages" Title="Poruke" ContentTemplate="{DataTemplate views:DmListPage}" />
        <ShellContent Route="profile" Title="Profil" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>
