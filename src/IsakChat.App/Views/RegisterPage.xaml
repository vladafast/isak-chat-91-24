<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IsakChat.App.ViewModels"
             x:Class="IsakChat.App.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Registracija">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="14">

            <Label Text="Napravi nalog" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" />

            <Entry Placeholder="Korisničko ime" Text="{Binding Username}" Margin="0,10,0,0" />
            <Entry Placeholder="Ime za prikaz (opciono)" Text="{Binding DisplayName}" />
            <Entry Placeholder="Lozinka" Text="{Binding Password}" IsPassword="True" />
            <Entry Placeholder="Ponovi lozinku" Text="{Binding ConfirmPassword}" IsPassword="True" />
            <Entry Placeholder="Adresa servera" Text="{Binding ServerUrl}" FontSize="12" />

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmptyConverter}}"
                   HorizontalTextAlignment="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Registruj se" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            <Button Text="Nazad na prijavu" Style="{StaticResource SecondaryButton}" Command="{Binding GoBackCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
