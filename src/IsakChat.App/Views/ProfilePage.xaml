<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IsakChat.App.ViewModels"
             x:Class="IsakChat.App.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profil">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Start">

        <Border WidthRequest="88" HeightRequest="88" BackgroundColor="{StaticResource SurfaceAlt}" HorizontalOptions="Center" Margin="0,20,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="44" />
            </Border.StrokeShape>
            <Label Text="{Binding DisplayName, Converter={StaticResource FirstLetterConverter}}" FontSize="34" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <Label Text="{Binding DisplayName}" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" />
        <Label Text="{Binding Username, StringFormat='@{0}'}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />

        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,10" />

        <Label Text="Server" Style="{StaticResource MutedLabel}" />
        <Label Text="{Binding ServerUrl}" />

        <Button Text="Odjavi se" Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" Margin="0,30,0,0" />

    </VerticalStackLayout>
</ContentPage>
