<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IsakChat.App.ViewModels"
             x:Class="IsakChat.App.Views.NewDmPage"
             x:DataType="vm:NewDmViewModel"
             Title="Novi četa">

    <Grid RowDefinitions="Auto,*">
        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,10" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Users}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Nema drugih korisnika još." Style="{StaticResource MutedLabel}" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:NewDmUserItem">
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectUserCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource SurfaceAlt}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label Text="{Binding DisplayName, Converter={StaticResource FirstLetterConverter}}" FontSize="16" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center" Spacing="1">
                            <Label Text="{Binding DisplayName}" />
                            <Label Text="✓ Već ćaskate" FontSize="11" TextColor="{StaticResource TextMuted}" IsVisible="{Binding AlreadyChatting}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
